#: accounts/serializers.py:137
msgid "Check your inbox to finish setting up your account."
msgstr "Revisá tu correo para terminar de crear tu cuenta."

#: accounts/serializers.py:156
msgid "You must accept the privacy policy to register."
msgstr "Tenés que aceptar la política de privacidad para registrarte."

#: accounts/serializers.py:302 accounts/serializers.py:403
msgid "Current password is incorrect."
msgstr "La contraseña actual no es correcta."

#: accounts/serializers.py:349
msgid "You cannot send a friend request to yourself."
msgstr "No podés enviarte una solicitud de amistad a vos mismo."

#: accounts/serializers.py:351
msgid "Friend request already sent."
msgstr "Ya enviaste la solicitud de amistad."

#: accounts/serializers.py:353
msgid "This user already sent you a friend request."
msgstr "Esta persona ya te envió una solicitud de amistad."

#: accounts/serializers.py:376
msgid "This person already accepted your invitation."
msgstr "Esta persona ya aceptó tu invitación."

#: accounts/views.py:210
msgid "Only the recipient can respond to a friend request."
msgstr "Sólo quien recibe la solicitud puede responderla."

#: accounts/views.py:216
msgid "status must be 'accepted' or 'declined'."
msgstr "status tiene que ser 'accepted' o 'declined'."

#: accounts/views.py:227
msgid "This friend request is no longer available."
msgstr "Esta solicitud de amistad ya no está disponible."

#: accounts/views.py:336
msgid "If an account exists for that email, a code has been sent."
msgstr "Si existe una cuenta con ese email, le enviamos un código."

#: accounts/views.py:381
msgid "Password updated."
msgstr "Contraseña actualizada."

#: pins/serializers.py:131
msgid "The same place is in the list twice."
msgstr "El mismo lugar está dos veces en la lista."

#: pins/views.py:51
msgid "isFavourite must be a boolean."
msgstr "isFavourite tiene que ser un booleano."

#: pins/views.py:75
msgid "You already pinned this restaurant."
msgstr "Ya tenés un pin en este restaurante."

#: places/geo.py:32
msgid "lat and lng are required."
msgstr "lat y lng son obligatorios."

#: places/geo.py:38
msgid "lat and lng must be numeric."
msgstr "lat y lng tienen que ser numéricos."

#: places/geo.py:41
msgid "lat/lng out of range."
msgstr "lat/lng fuera de rango."

#: places/geo.py:59
msgid "radius must be numeric."
msgstr "radius tiene que ser numérico."

#: places/geo.py:62
msgid "radius must be greater than 0."
msgstr "radius tiene que ser mayor que 0."

#: places/views.py:168
msgid "Google Places API is not configured."
msgstr "La API de Google Places no está configurada."

#: places/views.py:344
msgid "reverse geocode failed"
msgstr "falló la geocodificación inversa"

#: restaurants/serializers.py:153
msgid "latitude and longitude must be provided together."
msgstr "latitude y longitude tienen que ir juntas."

#: restaurants/serializers.py:155
msgid "latitude and longitude are required."
msgstr "latitude y longitude son obligatorias."

#: restaurants/services/reservations.py:78
msgid "The reservation URL has no host."
msgstr "La URL de reserva no tiene dominio."

#: restaurants/views.py:97 restaurants/views.py:104
msgid "Not found."
msgstr "No se encontró."

#: restaurants/views.py:146
msgid "placeId is required."
msgstr "placeId es obligatorio."

#: restaurants/views.py:159
msgid "This place is permanently closed."
msgstr "Este lugar cerró definitivamente."
