FROM python:3.13-slim

RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/base.txt requirements/base.txt
RUN pip install --no-cache-dir -r requirements/base.txt

COPY . .

# **Acá no se recolectan estáticos ni se compilan traducciones**, y las dos
# omisiones son deliberadas:
#
# - Los estáticos los arma `nginx/Dockerfile.aws:27`, que corre `collectstatic`
#   con `DJANGO_SECRET_KEY=build` inline y **sin** `|| true`, y copia el
#   resultado a la imagen que los sirve. Acá vivía la misma línea con
#   `2>/dev/null || true`: nunca hizo nada —`manage.py` carga settings.py, que
#   exige la SECRET_KEY, y en build time no hay env— y su salida tampoco se
#   usaba, porque este contenedor no sirve archivos. Era código muerto que se
#   leía como un bug.
# - Los `.mo` vienen versionados en `locale/`, con un test que verifica que
#   estén al día con sus `.po`. Intentar `compilemessages` acá falla por la
#   misma razón que fallaba el collectstatic, y el 2026-09-06 dejó el deploy en
#   rojo.

EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --fake-initial && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
