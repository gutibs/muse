FROM python:3.13-slim

RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    gettext \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/base.txt requirements/base.txt
RUN pip install --no-cache-dir -r requirements/base.txt

COPY . .

RUN python manage.py collectstatic --noinput 2>/dev/null || true

# Los .mo se compilan acá y NO van al repo (sólo los .po). Sin `|| true`
# a propósito: si esto falla, el build falla y el deploy se aborta con
# producción todavía en pie, que es mejor que servir los mensajes de error
# en inglés a una app configurada en otro idioma.
RUN python manage.py compilemessages

EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --fake-initial && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
