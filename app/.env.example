# Env del frontend. Copiar a `app/.env` para desarrollo:
#
#     cp app/.env.example app/.env
#
# Tiene que vivir acá y no en la raíz del repo: Vite resuelve `envDir` contra su
# root, que es `app/`. Un `.env` en la raíz no lo lee nadie por más que la
# variable esté escrita ahí — el síntoma es que todas las pantallas fallan con
# "Something went wrong", porque el cliente cae al `/api/v1` relativo y le pega
# al dev server de Vite en lugar de al backend.
#
# Los builds de Capacitor NO usan este archivo: toman `.env.capacitor` y
# `.env.capacitor-prod`, que ya están versionados en este mismo directorio
# porque sus URLs son públicas y fijas.

# Backend local. El puerto sale de docker-compose.dev.yml.
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Tiles del mapa (CARTO). Se pide gratis en https://carto.com/basemaps/apikey/
# (5M tiles/mes). Sin esta variable el mapa igual carga, pero CARTO sirve cada
# tile con "API KEY REQUIRED" estampado encima — no da error, se ve roto.
#
# NO va en los .env.capacitor*: esos sí están versionados y una credencial no
# entra al repo. Para los builds de APK se pasa por entorno:
#
#     VITE_CARTO_KEY=<la key> npm run build:apk-prod
#
# ...aunque desde esta máquina alcanza con tenerla acá: Vite carga `.env` en
# todos los modos, incluidos los de Capacitor. El corte de vite.config.ts
# existe para la máquina que no tenga ninguna de las dos: ahí el build falla
# en vez de escupir un APK con la marca de agua sobre cada mapa.
VITE_CARTO_KEY=
