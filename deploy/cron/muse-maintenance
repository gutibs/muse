# Mantenimiento periódico de Muse. Lo instala el deploy en /etc/cron.d/, así
# que este archivo es la única fuente: editarlo acá, no en el servidor.
#
# Por qué existe: los dos comandos estaban escritos para correr desde un cron
# que nadie había creado. `prune_activity` no había corrido nunca —al
# instalarlo, el 2026-08-19, borró 202 filas— y el caché de Places, que ahora
# guarda ~180 KB por foto en el disco del EC2, tampoco se limpiaba.
#
# El horario es UTC (el EC2 corre en Etc/UTC) y cae de madrugada del domingo,
# que es cuando menos tráfico hay.
#
# Rutas absolutas a propósito: cron corre con un PATH mínimo y no encuentra
# docker-compose por su cuenta.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# min hora díames mes díasem usuario  comando

# Caché de Google Places: borra lo que pasó los 30 días que permiten los
# Google Maps Platform Terms, con los archivos de las fotos. Semanal alcanza:
# el TTL es de 30 días y el volumen de escritura es bajo.
15 4 * * 0 root cd /home/ubuntu/muse && /usr/bin/docker-compose -f docker-compose.aws.yml exec -T backend python manage.py prune_place_cache 2>&1 | logger -t muse-prune-places

# Feed: 90 días de actividad. El comando rechaza un --days menor a 1, así que
# una variable vacía acá no puede vaciar la tabla.
45 4 * * 0 root cd /home/ubuntu/muse && /usr/bin/docker-compose -f docker-compose.aws.yml exec -T backend python manage.py prune_activity 2>&1 | logger -t muse-prune-activity

# Analytics: consolida el mes en curso y el anterior en el agregado por venue,
# que es lo único que sobrevive a la retención. Diario y no semanal porque el
# dashboard lee de acá para todo lo que no sea el mes corriente.
30 3 * * * root cd /home/ubuntu/muse && /usr/bin/docker-compose -f docker-compose.aws.yml exec -T backend python manage.py rollup_analytics 2>&1 | logger -t muse-rollup-analytics

# Y borra los eventos crudos que pasaron los 14 meses declarados en la
# política de privacidad. Consolida antes de borrar; corre después del rollup
# a propósito.
0 5 * * 0 root cd /home/ubuntu/muse && /usr/bin/docker-compose -f docker-compose.aws.yml exec -T backend python manage.py prune_analytics 2>&1 | logger -t muse-prune-analytics

# Códigos de recuperación de contraseña: la tabla guarda hashes de credenciales
# de un solo uso. Borra lo usado o vencido con más de 30 días; lo vigente no
# entra al filtro por viejo que sea el registro.
30 5 * * 0 root cd /home/ubuntu/muse && /usr/bin/docker-compose -f docker-compose.aws.yml exec -T backend python manage.py prune_password_reset_codes 2>&1 | logger -t muse-prune-reset-codes
