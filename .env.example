# Database
DB_NAME=muse
DB_USER=muse
DB_PASSWORD=muse_dev_password
DB_HOST=localhost
DB_PORT=5433

# Django
# In dev (DJANGO_DEBUG=1), settings.py falls back to a `django-insecure-`
# dev key if this is empty. In prod, missing key raises ImproperlyConfigured.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174

# Production HTTPS hardening — only consulted when DJANGO_DEBUG=0.
# Reverse proxy (nginx/Traefik) already terminates TLS, so SSL_REDIRECT
# stays off by default to avoid redirect loops.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000

# Frontend: las variables VITE_* NO van acá. Vite las busca en `app/`, no en la
# raíz, así que una VITE_API_BASE_URL escrita en este archivo no la lee nadie.
# Ver `app/.env.example`.

# Google Places (server-side only, never expose to frontend)
GOOGLE_PLACES_API_KEY=

# Nominatim reverse-geocoding proxy. Required by their usage policy:
# https://operations.osmfoundation.org/policies/nominatim/
# - APP_CONTACT_EMAIL: real address you can be reached at if they spot abuse.
# - NOMINATIM_USER_AGENT: descriptive UA identifying the app + version.
APP_CONTACT_EMAIL=contact@lovemuse.app
NOMINATIM_USER_AGENT=muse/1.0 (+https://lovemuse.app)

# Email — fallback Django SMTP/console (NOT used for invitations anymore;
# kept for future ad-hoc mail or Django admin password resets).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Muse <no-reply@localhost>
APP_PUBLIC_URL=http://localhost:5174
# Public base of the API itself. Separate from APP_PUBLIC_URL: photo proxy
# URLs built from it get persisted into Restaurant.image_url, so it has to be
# the API origin, not the SPA's. In prod both live on lovemuse.app.
API_PUBLIC_URL=http://localhost:8001

# Cache and throttling. Set by docker-compose in dev and prod; leave empty to
# fall back to per-process in-memory caching (what tests use). Without Redis
# the DRF throttle scopes count per gunicorn worker, so the real limit is
# roughly the configured rate times the worker count.
REDIS_URL=

# Resend (transactional email — invitations).
# Get a key at https://resend.com/api-keys (format: re_xxx...).
# Empty string disables sending and the service returns 503 to the caller.
# For testing without a verified domain, set DEFAULT_FROM_EMAIL above to
# "Muse <onboarding@resend.dev>" — that sandbox sender only delivers to
# the email registered on your Resend account.
RESEND_API_KEY=

# CARTO basemaps (map tiles). Consumed at BUILD time, not by Django: the nginx
# image passes it to the SvelteKit build as a build-arg (see the nginx service
# in docker-compose.aws.yml). Without it CARTO still answers 200 but stamps
# "API KEY REQUIRED" over every tile, so /shared/ maps look broken with nothing
# failing. The build refuses to run without it — the deploy builds before it
# stops anything, so a missing key leaves the running site untouched.
# Free up to 5M tiles/month: https://carto.com/basemaps/apikey/
VITE_CARTO_KEY=

# Cuántos proxies hay entre el cliente y Django (nginx = 1). Lo consume DRF a
# través de REST_FRAMEWORK["NUM_PROXIES"] para saber qué posición de
# X-Forwarded-For es la IP real del cliente. Ojo: DRF NO lee un NUM_PROXIES
# suelto a nivel de settings — ahí queda en None y los throttles pasan a
# identificar por la cadena XFF entera, que el cliente controla, así que basta
# variar el header para tener un cubo nuevo en cada request. Cambialo sólo si
# se agrega otro proxy delante.
DJANGO_NUM_PROXIES=1

# Adónde llegan las denuncias de contenido (App Store Guideline 1.2 exige poder
# actuar sobre ellas, no sólo recibirlas). Separado de APP_CONTACT_EMAIL porque
# esa casilla es pública y ésta la mira quien modera. Si falta, cae en
# APP_CONTACT_EMAIL.
MODERATION_EMAIL=
